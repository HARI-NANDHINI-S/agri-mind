# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://agrimind:agrimind_pass@db:3306/agrimind_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ─── Media / File uploads ────────────────────────────────────────────────────
MEDIA_ROOT=media/uploads
MAX_UPLOAD_SIZE_MB=10

# ─── ML ──────────────────────────────────────────────────────────────────────
ML_MODELS_DIR=app/ml/models
